+++ b/src/com/example/options/OptionExpiry.java
@@ -0,0 +1,35 @@
+package com.example.options;
+
+import java.time.Clock;
+import java.time.Duration;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.ZonedDateTime;
+import java.util.Objects;
+
+/** When an FX option expires, and how long it has left (OPT-772). */
+public record OptionExpiry(LocalDate expiryDate, Cut cut) {
+
+    private static final double SECONDS_PER_YEAR = 365.0 * 24 * 60 * 60;
+
+    public OptionExpiry {
+        Objects.requireNonNull(expiryDate, "expiryDate");
+        Objects.requireNonNull(cut, "cut");
+    }
+
+    /** The cut time on the expiry date, in the cut's own market. */
+    public Instant instant() {
+        return ZonedDateTime.of(expiryDate, cut.time(), cut.zone()).toInstant();
+    }
+
+    /** True from the moment of the cut onwards. */
+    public boolean isExpired(Clock clock) {
+        return !clock.instant().isBefore(instant());
+    }
+
+    /** Elapsed time to the cut as a fraction of a 365-day year; zero once expired. */
+    public double yearsToExpiry(Clock clock) {
+        long seconds = Duration.between(clock.instant(), instant()).getSeconds();
+        return Math.max(0, seconds) / SECONDS_PER_YEAR;
+    }
+}
diff --git a/tests/com/example/options/OptionExpiryTest.java b/tests/com/example/options/OptionExpiryTest.java
new file mode 100644
--- /dev/null
+++ b/tests/com/example/options/OptionExpiryTest.java
@@ -0,0 +1,44 @@
+package com.example.options;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.time.Clock;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.ZoneOffset;
+import org.junit.jupiter.api.Test;
+
+class OptionExpiryTest {
+
+    private static Clock at(String instant) {
+        return Clock.fixed(Instant.parse(instant), ZoneOffset.UTC);
+    }
+
+    @Test
+    void newYorkCutInWinter() {
+        OptionExpiry expiry = new OptionExpiry(LocalDate.of(2026, 1, 16), Cut.NEW_YORK);
+        assertEquals(Instant.parse("2026-01-16T15:00:00Z"), expiry.instant());
+    }
+
+    @Test
+    void tokyoCut() {
+        OptionExpiry expiry = new OptionExpiry(LocalDate.of(2026, 6, 19), Cut.TOKYO);
+        assertEquals(Instant.parse("2026-06-19T06:00:00Z"), expiry.instant());
+    }
+
+    @Test
+    void expiredFromTheCutOnwards() {
+        OptionExpiry expiry = new OptionExpiry(LocalDate.of(2026, 1, 16), Cut.NEW_YORK);
+        assertFalse(expiry.isExpired(at("2026-01-16T14:59:59Z")));
+        assertTrue(expiry.isExpired(at("2026-01-16T15:00:00Z")));
+    }
+
+    @Test
+    void yearsToExpiry() {
+        OptionExpiry expiry = new OptionExpiry(LocalDate.of(2026, 1, 16), Cut.NEW_YORK);
+        assertEquals(10.0 / 365, expiry.yearsToExpiry(at("2026-01-06T15:00:00Z")), 1e-12);
+        assertEquals(0.0, expiry.yearsToExpiry(at("2026-01-17T00:00:00Z")));
+    }
+}
