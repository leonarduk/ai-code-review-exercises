@@ -0,0 +1,29 @@
+"""Account-opening anniversaries for the annual custody fee."""
+
+from __future__ import annotations
+
+from datetime import date
+
+
+def anniversary(opened: date, year: int) -> date:
+    """The opening date's month and day in the given year."""
+    try:
+        return opened.replace(year=year)
+    except ValueError:
+        # 29 February in a year that has no 29 February
+        return date(year, 3, 1)
+
+
+def completed_years(opened: date, on: date) -> int:
+    """Whole years the account has been open on the given date."""
+    if on < opened:
+        raise ValueError(f"{on} is before the account was opened on {opened}")
+    return (on - opened).days // 365
+
+
+def next_anniversary(opened: date, after: date) -> date:
+    """The first anniversary strictly after the given date."""
+    candidate = anniversary(opened, max(after.year, opened.year + 1))
+    if candidate <= after:
+        candidate = anniversary(opened, candidate.year + 1)
+    return candidate
diff --git a/tests/test_anniversaries.py b/tests/test_anniversaries.py
new file mode 100644
--- /dev/null
+++ b/tests/test_anniversaries.py
@@ -0,0 +1,36 @@
+from datetime import date
+
+import pytest
+
+from anniversaries import anniversary, completed_years, next_anniversary
+
+
+def test_anniversary_keeps_month_and_day():
+    assert anniversary(date(2023, 6, 15), 2026) == date(2026, 6, 15)
+
+
+def test_leap_day_anniversary_in_a_leap_year():
+    assert anniversary(date(2024, 2, 29), 2028) == date(2028, 2, 29)
+
+
+@pytest.mark.parametrize(
+    ("on", "years"),
+    [
+        (date(2025, 6, 15), 0),
+        (date(2026, 6, 14), 0),
+        (date(2026, 6, 15), 1),
+        (date(2026, 12, 31), 1),
+    ],
+)
+def test_completed_years(on, years):
+    assert completed_years(date(2025, 6, 15), on) == years
+
+
+def test_dates_before_opening_are_rejected():
+    with pytest.raises(ValueError):
+        completed_years(date(2025, 6, 15), date(2025, 6, 14))
+
+
+def test_next_anniversary():
+    assert next_anniversary(date(2023, 6, 15), date(2026, 3, 1)) == date(2026, 6, 15)
+    assert next_anniversary(date(2023, 6, 15), date(2026, 6, 15)) == date(2027, 6, 15)
