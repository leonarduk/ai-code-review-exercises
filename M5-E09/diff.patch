-"""Submits payment instructions to the gateway."""
+"""Submits payment instructions to the gateway, with retries and a dead-letter queue (PAY-2388)."""
 
-from gateway import Gateway, Instruction
+import time
+from collections.abc import Callable
+from dataclasses import dataclass, field
+
+from gateway import Gateway, Instruction, RejectedError, TransientError
+
+BASE_DELAY_SECONDS = 1
+
+
+@dataclass
+class DeadLetter:
+    instruction_id: str
+    attempts: int
+    reasons: list[str] = field(default_factory=list)
 
 
 class PaymentSubmitter:
-    def __init__(self, gateway: Gateway):
+    def __init__(self, gateway: Gateway, max_attempts: int = 5,
+                 sleep: Callable[[float], None] = time.sleep,
+                 dead_letters: list[DeadLetter] = []):
         self._gateway = gateway
+        self._max_attempts = max_attempts
+        self._sleep = sleep
+        self.dead_letters = dead_letters
 
     def submit(self, instruction: Instruction) -> str:
-        self._gateway.submit(instruction)
-        return "sent"
+        """'sent', or 'dead-lettered' once the instruction cannot be sent."""
+        reasons = []
+        for attempt in range(1, self._max_attempts):
+            if attempt > 1:
+                self._sleep(BASE_DELAY_SECONDS * 2 ** (attempt - 2))
+            try:
+                self._gateway.submit(instruction)
+                return "sent"
+            except RejectedError as exc:
+                reasons.append(f"attempt {attempt}: rejected: {exc}")
+                break
+            except TransientError as exc:
+                reasons.append(f"attempt {attempt}: {exc}")
+        self.dead_letters.append(DeadLetter(instruction.instruction_id, len(reasons), reasons))
+        return "dead-lettered"
diff --git a/tests/test_submitter.py b/tests/test_submitter.py
new file mode 100644
--- /dev/null
+++ b/tests/test_submitter.py
@@ -0,0 +1,52 @@
+from decimal import Decimal
+
+from gateway import Instruction, RejectedError, TransientError
+from submitter import PaymentSubmitter
+
+PI_1 = Instruction("PI-1", "ACC-1", "GB29NWBK60161331926819", Decimal("250.00"))
+
+
+class FakeGateway:
+    def __init__(self, *outcomes):
+        self.outcomes = list(outcomes)
+        self.calls = 0
+
+    def submit(self, instruction):
+        self.calls += 1
+        outcome = self.outcomes.pop(0) if self.outcomes else None
+        if outcome is not None:
+            raise outcome
+
+
+def submitter(gateway, sleeps=None):
+    pauses = [] if sleeps is None else sleeps
+    return PaymentSubmitter(gateway, sleep=pauses.append, dead_letters=[])
+
+
+def test_sent_first_time():
+    gateway = FakeGateway()
+    assert submitter(gateway).submit(PI_1) == "sent"
+    assert gateway.calls == 1
+
+
+def test_transient_failures_are_retried_with_backoff():
+    sleeps = []
+    gateway = FakeGateway(TransientError("timeout"), TransientError("timeout"))
+    assert submitter(gateway, sleeps).submit(PI_1) == "sent"
+    assert gateway.calls == 3
+    assert sleeps == [1, 2]
+
+
+def test_a_rejection_is_dead_lettered_without_retrying():
+    gateway = FakeGateway(RejectedError("account closed"))
+    s = submitter(gateway)
+    assert s.submit(PI_1) == "dead-lettered"
+    assert gateway.calls == 1
+    assert [(d.instruction_id, d.attempts) for d in s.dead_letters] == [("PI-1", 1)]
+
+
+def test_an_instruction_that_keeps_failing_is_dead_lettered():
+    gateway = FakeGateway(*[TransientError("unavailable")] * 10)
+    s = submitter(gateway)
+    assert s.submit(PI_1) == "dead-lettered"
+    assert s.dead_letters[0].instruction_id == "PI-1"
