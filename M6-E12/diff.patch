+package com.example.mandates;
+
+import java.math.BigDecimal;
+
+/** A collection accepted under a mandate. */
+public record DirectDebit(Mandate mandate, BigDecimal amount, SequenceType sequenceType) {
+
+    /** FRST for the first collection under a mandate, RCUR for every later one. */
+    public enum SequenceType {
+        FRST,
+        RCUR
+    }
+}
diff --git a/src/com/example/mandates/MandateKey.java b/src/com/example/mandates/MandateKey.java
new file mode 100644
--- /dev/null
+++ b/src/com/example/mandates/MandateKey.java
@@ -0,0 +1,16 @@
+package com.example.mandates;
+
+/** Identifies a mandate: the creditor id exactly, the mandate reference in any letter case. */
+record MandateKey(String creditorId, String reference) {
+
+    static MandateKey of(Mandate mandate) {
+        return new MandateKey(mandate.creditorId(), mandate.reference());
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        return o instanceof MandateKey k
+                && creditorId.equals(k.creditorId)
+                && reference.equalsIgnoreCase(k.reference);
+    }
+}
