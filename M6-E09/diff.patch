+package com.example.status;
+
+/** Transaction status codes in the scheme's pain.002 status reports. */
+public enum SchemeStatus {
+    /** Accepted for processing. */
+    ACCP,
+    /** Pending at the scheme. */
+    PDNG,
+    /** Accepted, settlement in process. */
+    ACSP,
+    /** Settlement completed. */
+    ACSC,
+    /** Rejected. */
+    RJCT
+}
diff --git a/src/com/example/status/StatusReportHandler.java b/src/com/example/status/StatusReportHandler.java
new file mode 100644
--- /dev/null
+++ b/src/com/example/status/StatusReportHandler.java
@@ -0,0 +1,33 @@
+package com.example.status;
+
+/** Applies the scheme's status reports to outgoing payments (PAY-1419). */
+public final class StatusReportHandler {
+
+    private final Funds funds;
+
+    public StatusReportHandler(Funds funds) {
+        this.funds = funds;
+    }
+
+    public void apply(Payment payment, String statusCode) {
+        SchemeStatus status = SchemeStatus.valueOf(statusCode.trim());
+        if (payment.isFinal()) {
+            return;
+        }
+        switch (status) {
+            case ACCP:
+            case PDNG:
+                break;
+            case ACSP:
+                payment.moveTo(Payment.State.IN_PROCESS);
+            case ACSC:
+                payment.moveTo(Payment.State.SETTLED);
+                funds.debit(payment.debtorAccount(), payment.amount());
+                break;
+            case RJCT:
+                payment.moveTo(Payment.State.REJECTED);
+                funds.release(payment.debtorAccount(), payment.amount());
+                break;
+        }
+    }
+}
diff --git a/tests/com/example/status/StatusReportHandlerTest.java b/tests/com/example/status/StatusReportHandlerTest.java
