--- a/savings.py
+++ b/savings.py
@@ -1,8 +1,12 @@
 """Savings account interest."""
 
+from __future__ import annotations
+
+from dataclasses import dataclass
 from decimal import Decimal, ROUND_HALF_EVEN
 
 CENT = Decimal("0.01")
+MONTHS_PER_YEAR = 12
 
 
 def annual_interest(balance: Decimal, annual_rate: Decimal) -> Decimal:
@@ -10,3 +14,54 @@
     if balance < 0 or annual_rate < 0:
         raise ValueError("balance and rate must be non-negative")
     return (balance * annual_rate).quantize(CENT, rounding=ROUND_HALF_EVEN)
+
+
+@dataclass(frozen=True)
+class MonthlyCredit:
+    month: int
+    interest: Decimal
+    closing_balance: Decimal
+
+
+def _whole_cents(name: str, value: Decimal) -> Decimal:
+    if not value.is_finite() or value < 0 or value != value.quantize(CENT):
+        raise ValueError(f"{name} must be a non-negative whole number of cents, got {value}")
+    return value
+
+
+def project_savings(
+    opening_balance: Decimal,
+    annual_rate: Decimal,
+    months: int,
+    monthly_deposit: Decimal = Decimal("0.00"),
+) -> list[MonthlyCredit]:
+    """Month-by-month projection of a savings account with monthly compounding.
+
+    Each month's interest is rounded to the cent and credited, as the ledger
+    posts it; the deposit is paid in after the interest is credited.
+    """
+    balance = _whole_cents("opening balance", opening_balance)
+    deposit = _whole_cents("monthly deposit", monthly_deposit)
+    if not annual_rate.is_finite() or annual_rate < 0:
+        raise ValueError(f"rate must be finite and non-negative, got {annual_rate}")
+    if months < 0:
+        raise ValueError("months must be non-negative")
+    projection = []
+    for month in range(1, months + 1):
+        interest = (balance * annual_rate / MONTHS_PER_YEAR).quantize(CENT, rounding=ROUND_HALF_EVEN)
+        balance = balance + interest + deposit
+        projection.append(MonthlyCredit(month, interest, balance))
+    return projection
+
+
+def total_interest(projection: list[MonthlyCredit]) -> Decimal:
+    """Interest credited over the whole projection."""
+    return sum((credit.interest for credit in projection), Decimal("0.00"))
+
+
+def aer(annual_rate: Decimal) -> Decimal:
+    """Annual equivalent rate of monthly compounding, in percent to 2 places."""
+    if not annual_rate.is_finite() or annual_rate < 0:
+        raise ValueError(f"rate must be finite and non-negative, got {annual_rate}")
+    growth = (1 + annual_rate / MONTHS_PER_YEAR) ** MONTHS_PER_YEAR
+    return ((growth - 1) * 100).quantize(CENT, rounding=ROUND_HALF_EVEN)
diff --git a/tests/test_savings.py b/tests/test_savings.py
--- a/tests/test_savings.py
+++ b/tests/test_savings.py
@@ -2,7 +2,7 @@
 
 import pytest
 
-from savings import annual_interest
+from savings import MonthlyCredit, aer, annual_interest, project_savings, total_interest
 
 
 def test_annual_interest():
@@ -16,3 +16,44 @@
 def test_negative_balance_is_rejected():
     with pytest.raises(ValueError):
         annual_interest(Decimal("-1.00"), Decimal("0.05"))
+
+
+def test_first_months_of_a_projection():
+    projection = project_savings(Decimal("1200.00"), Decimal("0.06"), 3)
+    assert projection == [
+        MonthlyCredit(1, Decimal("6.00"), Decimal("1206.00")),
+        MonthlyCredit(2, Decimal("6.03"), Decimal("1212.03")),
+        MonthlyCredit(3, Decimal("6.06"), Decimal("1218.09")),
+    ]
+
+
+def test_deposit_is_paid_in_after_the_interest():
+    projection = project_savings(Decimal("0.00"), Decimal("0.06"), 2, Decimal("100.00"))
+    assert [credit.interest for credit in projection] == [Decimal("0.00"), Decimal("0.50")]
+    assert projection[-1].closing_balance == Decimal("200.50")
+
+
+def test_total_interest_over_a_year():
+    projection = project_savings(Decimal("1200.00"), Decimal("0.06"), 12)
+    assert total_interest(projection) == Decimal("74.01")
+    assert projection[-1].closing_balance == Decimal("1274.01")
+
+
+def test_aer_of_monthly_compounding():
+    assert aer(Decimal("0.06")) == Decimal("6.17")
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"opening_balance": Decimal("-1.00")},
+        {"opening_balance": Decimal("1.005")},
+        {"annual_rate": Decimal("-0.01")},
+        {"months": -1},
+        {"monthly_deposit": Decimal("-5.00")},
+    ],
+)
+def test_invalid_inputs_are_rejected(kwargs):
+    args = {"opening_balance": Decimal("100.00"), "annual_rate": Decimal("0.05"), "months": 1}
+    with pytest.raises(ValueError):
+        project_savings(**{**args, **kwargs})
