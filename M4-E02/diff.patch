diff --git a/src/com/example/fx/SpotDateCalculator.java b/src/com/example/fx/SpotDateCalculator.java
new file mode 100644
--- /dev/null
+++ b/src/com/example/fx/SpotDateCalculator.java
@@ -0,0 +1,60 @@
+package com.example.fx;
+
+import java.time.DayOfWeek;
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.time.LocalTime;
+import java.time.ZonedDateTime;
+import java.util.Map;
+
+/** Trade date and spot value date for FX deals (FXO-318). */
+public final class SpotDateCalculator {
+
+    private static final LocalTime FX_DAY_ROLL = LocalTime.of(17, 0);
+    private static final int SPOT_LAG = 2;
+
+    private final Map<String, HolidayCalendar> calendars;
+
+    public SpotDateCalculator(Map<String, HolidayCalendar> calendars) {
+        this.calendars = Map.copyOf(calendars);
+    }
+
+    /** The FX trade date: the day rolls at 17:00 New York time, and never lands on a weekend. */
+    public LocalDate tradeDate(ZonedDateTime executedAt) {
+        LocalDateTime local = executedAt.toLocalDateTime();
+        LocalDate day = local.toLocalTime().isBefore(FX_DAY_ROLL)
+                ? local.toLocalDate()
+                : local.toLocalDate().plusDays(1);
+        while (day.getDayOfWeek() == DayOfWeek.SATURDAY || day.getDayOfWeek() == DayOfWeek.SUNDAY) {
+            day = day.plusDays(1);
+        }
+        return day;
+    }
+
+    /** Trade date plus two business days. */
+    public LocalDate spotDate(CurrencyPair pair, ZonedDateTime executedAt) {
+        requireCalendars(pair);
+        LocalDate date = tradeDate(executedAt);
+        int added = 0;
+        while (added < SPOT_LAG) {
+            date = date.plusDays(1);
+            if (calendarFor(pair.base()).isBusinessDay(date)) {
+                added++;
+            }
+        }
+        return date;
+    }
+
+    private void requireCalendars(CurrencyPair pair) {
+        calendarFor(pair.base());
+        calendarFor(pair.quote());
+    }
+
+    private HolidayCalendar calendarFor(String currency) {
+        HolidayCalendar calendar = calendars.get(currency);
+        if (calendar == null) {
+            throw new IllegalArgumentException("no settlement calendar for " + currency);
+        }
+        return calendar;
+    }
+}
diff --git a/tests/com/example/fx/SpotDateCalculatorTest.java b/tests/com/example/fx/SpotDateCalculatorTest.java
new file mode 100644
--- /dev/null
+++ b/tests/com/example/fx/SpotDateCalculatorTest.java
@@ -0,0 +1,47 @@
+package com.example.fx;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import java.time.LocalDate;
+import java.time.ZoneId;
+import java.time.ZonedDateTime;
+import java.util.Map;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+
+class SpotDateCalculatorTest {
+
+    private static final ZoneId NEW_YORK = ZoneId.of("America/New_York");
+    private static final HolidayCalendar EUR = new HolidayCalendar(
+            Set.of(LocalDate.of(2026, 4, 3), LocalDate.of(2026, 4, 6), LocalDate.of(2026, 5, 1)));
+    private static final HolidayCalendar USD = new HolidayCalendar(Set.of(LocalDate.of(2026, 7, 3)));
+
+    private final SpotDateCalculator calculator = new SpotDateCalculator(Map.of("EUR", EUR, "USD", USD));
+
+    @Test
+    void spotIsTwoBusinessDaysAfterTheTradeDate() {
+        ZonedDateTime tuesdayMorning = ZonedDateTime.of(2026, 3, 10, 9, 0, 0, 0, NEW_YORK);
+        assertEquals(LocalDate.of(2026, 3, 12), calculator.spotDate(CurrencyPair.parse("EURUSD"), tuesdayMorning));
+    }
+
+    @Test
+    void tradesAfterFiveInTheAfternoonBelongToTheNextDay() {
+        ZonedDateTime tuesdayEvening = ZonedDateTime.of(2026, 3, 10, 17, 30, 0, 0, NEW_YORK);
+        assertEquals(LocalDate.of(2026, 3, 11), calculator.tradeDate(tuesdayEvening));
+        assertEquals(LocalDate.of(2026, 3, 13), calculator.spotDate(CurrencyPair.parse("EUR/USD"), tuesdayEvening));
+    }
+
+    @Test
+    void easterHolidaysAreSkipped() {
+        ZonedDateTime thursday = ZonedDateTime.of(2026, 4, 2, 11, 0, 0, 0, NEW_YORK);
+        assertEquals(LocalDate.of(2026, 4, 8), calculator.spotDate(CurrencyPair.parse("EURUSD"), thursday));
+    }
+
+    @Test
+    void unknownCurrencyIsRejected() {
+        ZonedDateTime monday = ZonedDateTime.of(2026, 3, 9, 9, 0, 0, 0, NEW_YORK);
+        assertThrows(IllegalArgumentException.class,
+                () -> calculator.spotDate(CurrencyPair.parse("EURXYZ"), monday));
+    }
+}
