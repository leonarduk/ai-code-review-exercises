 public final class SettlementBatch {
 
+    /** The highest merchant discount rate the acquirer agrees: 10%. */
+    public static final int MAX_MDR_BASIS_POINTS = 1_000;
+    private static final double BASIS_POINTS_PER_UNIT = 10_000.0;
