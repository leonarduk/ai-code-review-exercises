diff --git a/executions.py b/executions.py
new file mode 100644
--- /dev/null
+++ b/executions.py
@@ -0,0 +1,49 @@
+"""Merge execution reports from several venues into one timeline."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from zoneinfo import ZoneInfo
+
+LEGACY_VENUE_ZONE = ZoneInfo("Europe/London")
+LEGACY_FORMAT = "%Y-%m-%d %H:%M:%S"
+
+
+class TimestampError(ValueError):
+    """A venue timestamp that cannot be placed on the timeline."""
+
+
+@dataclass(frozen=True)
+class Execution:
+    venue: str
+    execution_id: str
+    timestamp: str          # as reported by the venue
+    executed_at: datetime   # timezone-aware, UTC
+
+
+def parse_iso(text: str) -> datetime:
+    """ISO 8601 venues: the timestamp must carry an offset or Z."""
+    try:
+        parsed = datetime.fromisoformat(text)
+    except ValueError:
+        raise TimestampError(f"not an ISO 8601 timestamp: {text!r}") from None
+    if parsed.tzinfo is None:
+        raise TimestampError(f"timestamp has no UTC offset: {text!r}")
+    return parsed.astimezone(timezone.utc)
+
+
+def parse_legacy(text: str) -> datetime:
+    """The legacy venue reports London wall-clock time without an offset."""
+    local = datetime.strptime(text, LEGACY_FORMAT).replace(tzinfo=LEGACY_VENUE_ZONE)
+    return local.astimezone(timezone.utc)
+
+
+def execution(venue: str, execution_id: str, timestamp: str, legacy: bool = False) -> Execution:
+    executed_at = parse_legacy(timestamp) if legacy else parse_iso(timestamp)
+    return Execution(venue, execution_id, timestamp, executed_at)
+
+
+def merge(executions: list[Execution]) -> list[Execution]:
+    """Every execution in time order, earliest first; ties keep input order."""
+    return sorted(executions, key=lambda e: e.timestamp)
diff --git a/tests/test_executions.py b/tests/test_executions.py
new file mode 100644
--- /dev/null
+++ b/tests/test_executions.py
@@ -0,0 +1,31 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from executions import TimestampError, execution, merge, parse_iso, parse_legacy
+
+UTC = timezone.utc
+
+
+def test_parse_iso_with_z_and_offsets():
+    assert parse_iso("2026-03-10T14:15:00Z") == datetime(2026, 3, 10, 14, 15, tzinfo=UTC)
+    assert parse_iso("2026-03-10T09:30:00-05:00") == datetime(2026, 3, 10, 14, 30, tzinfo=UTC)
+
+
+def test_parse_iso_rejects_a_missing_offset():
+    with pytest.raises(TimestampError):
+        parse_iso("2026-03-10T14:15:00")
+
+
+def test_parse_legacy_in_winter_and_summer():
+    assert parse_legacy("2026-01-15 09:00:00") == datetime(2026, 1, 15, 9, 0, tzinfo=UTC)
+    assert parse_legacy("2026-07-15 09:00:00") == datetime(2026, 7, 15, 8, 0, tzinfo=UTC)
+
+
+def test_merge_orders_executions():
+    reports = [
+        execution("LSE", "L-2", "2026-03-10T14:15:00Z"),
+        execution("LSE", "L-1", "2026-03-10T08:05:00Z"),
+        execution("LSE", "L-3", "2026-03-10T16:29:59Z"),
+    ]
+    assert [e.execution_id for e in merge(reports)] == ["L-1", "L-2", "L-3"]
