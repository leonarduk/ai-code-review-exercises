diff --git a/reconcile.py b/reconcile.py
new file mode 100644
--- /dev/null
+++ b/reconcile.py
@@ -0,0 +1,48 @@
+"""Matches bank statement lines against expected ledger receipts in GBP (OPS-2402)."""
+
+from collections.abc import Iterable
+from dataclasses import dataclass, field
+from datetime import date
+from decimal import ROUND_HALF_EVEN, Decimal
+
+PENNY = Decimal("0.01")
+
+
+@dataclass
+class Report:
+    matched: list[str] = field(default_factory=list)
+    unmatched_statement: list[str] = field(default_factory=list)
+    unmatched_ledger: list[str] = field(default_factory=list)
+    malformed: list[tuple[int, str]] = field(default_factory=list)
+
+
+def parse_line(line: str, gbp_per_unit: dict[str, Decimal]) -> tuple[str, Decimal]:
+    """(reference, amount in GBP) from one statement line."""
+    day, reference, amount, currency = line.split(",")
+    date.fromisoformat(day)
+    rate = gbp_per_unit.get(currency.strip(), Decimal("1"))
+    value = Decimal(amount)
+    if not value.is_finite():
+        raise ValueError(f"not an amount: {amount!r}")
+    return reference.strip(), (value * rate).quantize(PENNY, rounding=ROUND_HALF_EVEN)
+
+
+def reconcile(lines: Iterable[str], ledger: dict[str, Decimal], gbp_per_unit: dict[str, Decimal]) -> Report:
+    report = Report()
+    outstanding = dict(ledger)
+    for number, line in enumerate(lines, start=1):
+        if not line.strip():
+            continue
+        try:
+            reference, gbp = parse_line(line, gbp_per_unit)
+        except Exception:
+            continue
+        expected = outstanding.pop(reference, None)
+        if expected == gbp:
+            report.matched.append(reference)
+        else:
+            report.unmatched_statement.append(reference)
+            if expected is not None:
+                outstanding[reference] = expected
+    report.unmatched_ledger = sorted(outstanding)
+    return report
diff --git a/tests/test_reconcile.py b/tests/test_reconcile.py
new file mode 100644
--- /dev/null
+++ b/tests/test_reconcile.py
@@ -0,0 +1,33 @@
+from decimal import Decimal
+
+from reconcile import reconcile
+
+RATES = {"GBP": Decimal("1"), "EUR": Decimal("0.86"), "USD": Decimal("0.79")}
+
+
+def test_matching_lines():
+    report = reconcile(
+        ["2026-09-01,INV-1,250.00,GBP", "2026-09-01,INV-2,100.00,EUR"],
+        {"INV-1": Decimal("250.00"), "INV-2": Decimal("86.00")},
+        RATES,
+    )
+    assert report.matched == ["INV-1", "INV-2"]
+    assert report.unmatched_statement == report.unmatched_ledger == []
+
+
+def test_amount_mismatch_is_unmatched_on_both_sides():
+    report = reconcile(["2026-09-01,INV-1,249.00,GBP"], {"INV-1": Decimal("250.00")}, RATES)
+    assert report.unmatched_statement == ["INV-1"]
+    assert report.unmatched_ledger == ["INV-1"]
+
+
+def test_unexpected_receipt_and_missing_receipt():
+    report = reconcile(["2026-09-01,INV-9,10.00,USD"], {"INV-1": Decimal("250.00")}, RATES)
+    assert report.unmatched_statement == ["INV-9"]
+    assert report.unmatched_ledger == ["INV-1"]
+
+
+def test_blank_lines_are_ignored():
+    report = reconcile(["", "2026-09-01,INV-1,250.00,GBP", "  "], {"INV-1": Decimal("250.00")}, RATES)
+    assert report.matched == ["INV-1"]
+    assert report.malformed == []
