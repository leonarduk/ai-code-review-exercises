@@ -0,0 +1,34 @@
+package com.example.marketdata;
+
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.LocalTime;
+import java.time.ZoneId;
+import java.time.ZonedDateTime;
+import java.time.temporal.ChronoUnit;
+import java.util.Objects;
+
+/** When a capture job next runs: a local time of day in a market's zone (MKT-877). */
+public record RunSchedule(LocalTime runTime, ZoneId zone) {
+
+    public RunSchedule {
+        Objects.requireNonNull(runTime, "runTime");
+        Objects.requireNonNull(zone, "zone");
+    }
+
+    /** The first daily run strictly after the given instant. */
+    public Instant nextDailyRun(Instant after) {
+        Instant today = runOn(LocalDate.ofInstant(after, zone));
+        return today.isAfter(after) ? today : today.plus(1, ChronoUnit.DAYS);
+    }
+
+    /** The first run on the 1st of a month strictly after the given instant. */
+    public Instant nextMonthlyRun(Instant after) {
+        Instant thisMonth = runOn(LocalDate.ofInstant(after, zone).withDayOfMonth(1));
+        return thisMonth.isAfter(after) ? thisMonth : thisMonth.plus(1, ChronoUnit.MONTHS);
+    }
+
+    private Instant runOn(LocalDate date) {
+        return ZonedDateTime.of(date, runTime, zone).toInstant();
+    }
+}
diff --git a/tests/com/example/marketdata/RunScheduleTest.java b/tests/com/example/marketdata/RunScheduleTest.java
new file mode 100644
--- /dev/null
+++ b/tests/com/example/marketdata/RunScheduleTest.java
@@ -0,0 +1,37 @@
+package com.example.marketdata;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.time.Instant;
+import java.time.LocalTime;
+import java.time.ZoneId;
+import org.junit.jupiter.api.Test;
+
+class RunScheduleTest {
+
+    private static final RunSchedule FOUR_PM_LONDON = new RunSchedule(LocalTime.of(16, 0), ZoneId.of("Europe/London"));
+
+    @Test
+    void laterTheSameDay() {
+        assertEquals(Instant.parse("2026-01-14T16:00:00Z"),
+                FOUR_PM_LONDON.nextDailyRun(Instant.parse("2026-01-14T09:00:00Z")));
+    }
+
+    @Test
+    void afterTodaysRunItIsTomorrow() {
+        assertEquals(Instant.parse("2026-01-15T16:00:00Z"),
+                FOUR_PM_LONDON.nextDailyRun(Instant.parse("2026-01-14T16:00:00Z")));
+    }
+
+    @Test
+    void summerTime() {
+        assertEquals(Instant.parse("2026-07-14T15:00:00Z"),
+                FOUR_PM_LONDON.nextDailyRun(Instant.parse("2026-07-14T08:00:00Z")));
+    }
+
+    @Test
+    void monthlyRunOnTheFirst() {
+        assertEquals(Instant.parse("2026-06-01T15:00:00Z"),
+                FOUR_PM_LONDON.nextMonthlyRun(Instant.parse("2026-05-31T23:30:00Z")));
+    }
+}
