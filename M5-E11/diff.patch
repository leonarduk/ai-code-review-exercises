-"""One-line descriptions of payment events for the application log."""
+"""One-line descriptions of payment events for the application log.
+
+Card numbers and IBANs are masked before anything is logged (SEC-311).
+"""
+
+import re
+
+CARD_NUMBER_IN_TEXT = re.compile(r"\b(?:\d{4}[ -]?){3}\d{4}\b")
+
+
+def mask_pan(pan: str) -> str:
+    """Only the last four digits stay visible."""
+    digits = re.sub(r"[ -]", "", pan)
+    return "*" * (len(digits) - 4) + digits[-4:]
+
+
+def mask_iban(iban: str) -> str:
+    """Only the country code and the last four characters stay visible."""
+    compact = iban.replace(" ", "").upper()
+    return compact[:2] + "*" * (len(compact) - 6) + compact[-4:]
+
+
+def redact(text: str) -> str:
+    """Mask every card number that appears in free text."""
+    return CARD_NUMBER_IN_TEXT.sub(lambda match: mask_pan(match.group()), text)
 
 
 def log_line(event: dict) -> str:
+    if event["method"] == "card":
+        payer = mask_pan(event["payer"])
+    else:
+        payer = mask_iban(event["payer"])
     return (f"payment {event['payment_id']} {event['amount']} {event['currency']} "
-            f"via {event['method']} from={event['payer']} ref={event['reference']}")
+            f"via {event['method']} from={payer} ref={redact(event['reference'])}")
diff --git a/tests/test_payment_log.py b/tests/test_payment_log.py
new file mode 100644
--- /dev/null
+++ b/tests/test_payment_log.py
@@ -0,0 +1,24 @@
+from payment_log import log_line, mask_iban, mask_pan, redact
+
+
+def test_card_numbers_show_only_the_last_four_digits():
+    assert mask_pan("4111111111111111") == "************1111"
+    assert mask_pan("4111 1111 1111 1111") == "************1111"
+
+
+def test_ibans_show_only_the_country_and_last_four():
+    assert mask_iban("DE89 3704 0044 0532 0130 00") == "DE****************3000"
+
+
+def test_card_numbers_in_free_text_are_masked():
+    assert redact("customer typed 5500-0000-0000-0004 here") == "customer typed ************0004 here"
+    assert redact("invoice 2291") == "invoice 2291"
+
+
+def test_log_line_masks_the_payer_and_the_reference():
+    line = log_line({"payment_id": "pay_1", "amount": "25.00", "currency": "EUR", "method": "card",
+                     "payer": "4111111111111111", "reference": "order 4111 1111 1111 1111"})
+    assert line == "payment pay_1 25.00 EUR via card from=************1111 ref=order ************1111"
+    line = log_line({"payment_id": "pay_2", "amount": "80.00", "currency": "EUR", "method": "sepa",
+                     "payer": "DE89370400440532013000", "reference": "rent"})
+    assert "from=DE****************3000" in line
