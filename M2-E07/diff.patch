+package com.example.invoices;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+import java.time.temporal.ChronoUnit;
+import java.util.Objects;
+
+/**
+ * Statutory interest on overdue invoices: simple interest, ACT/365 Fixed,
+ * from the due date up to (not including) the payment date, rounded half-up
+ * to the cent.
+ */
+public final class LatePaymentInterest {
+
+    private static final BigDecimal DAYS_IN_YEAR = BigDecimal.valueOf(365);
+    private static final BigDecimal NO_INTEREST = BigDecimal.ZERO.setScale(2);
+
+    private final BigDecimal annualRate;
+
+    public LatePaymentInterest(StatutoryRates rates) {
+        Objects.requireNonNull(rates, "rates");
+        this.annualRate = BigDecimal.valueOf(rates.latePaymentAnnualRate());
+    }
+
+    public BigDecimal interest(BigDecimal overdueAmount, LocalDate dueDate, LocalDate paidDate) {
+        Objects.requireNonNull(overdueAmount, "overdueAmount");
+        if (overdueAmount.compareTo(BigDecimal.ZERO) <= 0 || !paidDate.isAfter(dueDate)) {
+            return NO_INTEREST;
+        }
+        long daysLate = ChronoUnit.DAYS.between(dueDate, paidDate);
+        return overdueAmount
+                .multiply(annualRate)
+                .multiply(BigDecimal.valueOf(daysLate))
+                .divide(DAYS_IN_YEAR, 2, RoundingMode.HALF_UP);
+    }
+}
diff --git a/tests/com/example/invoices/LatePaymentInterestTest.java b/tests/com/example/invoices/LatePaymentInterestTest.java
new file mode 100644
--- /dev/null
+++ b/tests/com/example/invoices/LatePaymentInterestTest.java
@@ -0,0 +1,34 @@
+package com.example.invoices;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import org.junit.jupiter.api.Test;
+
+class LatePaymentInterestTest {
+
+    private final LatePaymentInterest interest =
+            new LatePaymentInterest(new StatutoryRates(0.0825));
+
+    @Test
+    void interestForThirtyDaysLate() {
+        // 10,000.00 x 8.25% x 30 / 365 = 67.808...
+        assertEquals(new BigDecimal("67.81"), interest.interest(
+                new BigDecimal("10000.00"), LocalDate.of(2024, 5, 1), LocalDate.of(2024, 5, 31)));
+    }
+
+    @Test
+    void noInterestWhenPaidOnTime() {
+        assertEquals(new BigDecimal("0.00"), interest.interest(
+                new BigDecimal("10000.00"), LocalDate.of(2024, 5, 1), LocalDate.of(2024, 5, 1)));
+        assertEquals(new BigDecimal("0.00"), interest.interest(
+                new BigDecimal("10000.00"), LocalDate.of(2024, 5, 1), LocalDate.of(2024, 4, 20)));
+    }
+
+    @Test
+    void noInterestOnACreditBalance() {
+        assertEquals(new BigDecimal("0.00"), interest.interest(
+                new BigDecimal("-50.00"), LocalDate.of(2024, 5, 1), LocalDate.of(2024, 6, 1)));
+    }
+}
