--- /dev/null
+++ b/src/com/example/invoicing/VatCalculator.java
@@ -0,0 +1,48 @@
+package com.example.invoicing;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.util.List;
+import java.util.Objects;
+
+/** UK VAT on invoice lines and on VAT-inclusive receipts. */
+public final class VatCalculator {
+
+    private static final int PENCE = 2;
+
+    private VatCalculator() {
+    }
+
+    /** The VAT on a net amount, rounded half-up to the penny. */
+    public static BigDecimal vatOnNet(BigDecimal net, BigDecimal rate) {
+        Objects.requireNonNull(net, "net");
+        checkRate(rate);
+        return net.multiply(rate).setScale(PENCE, RoundingMode.HALF_UP);
+    }
+
+    /**
+     * The VAT contained in a VAT-inclusive amount, gross x rate / (1 + rate),
+     * rounded half-up to the penny. At the standard rate this is 1/6 of the
+     * gross.
+     */
+    public static BigDecimal vatInGross(BigDecimal gross, BigDecimal rate) {
+        Objects.requireNonNull(gross, "gross");
+        checkRate(rate);
+        return gross.multiply(rate).divide(BigDecimal.ONE.add(rate), PENCE, RoundingMode.HALF_UP);
+    }
+
+    /** The VAT on an invoice: each line's VAT, rounded, then summed. */
+    public static BigDecimal invoiceVat(List<InvoiceLine> lines) {
+        Objects.requireNonNull(lines, "lines");
+        return lines.stream()
+                .map(line -> vatOnNet(line.net(), line.vatRate()))
+                .reduce(BigDecimal.ZERO.setScale(PENCE), BigDecimal::add);
+    }
+
+    private static void checkRate(BigDecimal rate) {
+        Objects.requireNonNull(rate, "rate");
+        if (rate.signum() < 0 || rate.compareTo(BigDecimal.ONE) == 1) {
+            throw new IllegalArgumentException("VAT rate must be a fraction from 0 to 1: " + rate);
+        }
+    }
+}
diff --git a/tests/com/example/invoicing/VatCalculatorTest.java b/tests/com/example/invoicing/VatCalculatorTest.java
new file mode 100644
--- /dev/null
+++ b/tests/com/example/invoicing/VatCalculatorTest.java
@@ -0,0 +1,47 @@
+package com.example.invoicing;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import java.math.BigDecimal;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+class VatCalculatorTest {
+
+    private static final BigDecimal STANDARD = new BigDecimal("0.20");
+    private static final BigDecimal REDUCED = new BigDecimal("0.05");
+
+    @Test
+    void vatOnANetAmount() {
+        assertEquals(new BigDecimal("25.00"), VatCalculator.vatOnNet(new BigDecimal("125.00"), STANDARD));
+        // 19.99 x 5% = 0.9995
+        assertEquals(new BigDecimal("1.00"), VatCalculator.vatOnNet(new BigDecimal("19.99"), REDUCED));
+    }
+
+    @Test
+    void zeroRatedLinesCarryNoVat() {
+        assertEquals(new BigDecimal("0.00"), VatCalculator.vatOnNet(new BigDecimal("80.00"), BigDecimal.ZERO));
+    }
+
+    @Test
+    void vatInAVatInclusiveAmount() {
+        assertEquals(new BigDecimal("20.00"), VatCalculator.vatInGross(new BigDecimal("120.00"), STANDARD));
+        assertEquals(new BigDecimal("5.00"), VatCalculator.vatInGross(new BigDecimal("105.00"), REDUCED));
+    }
+
+    @Test
+    void invoiceVatSumsTheLines() {
+        List<InvoiceLine> lines = List.of(
+                new InvoiceLine("Consulting", new BigDecimal("1000.00"), STANDARD),
+                new InvoiceLine("Child car seat", new BigDecimal("80.00"), REDUCED),
+                new InvoiceLine("Books", new BigDecimal("45.00"), BigDecimal.ZERO));
+        assertEquals(new BigDecimal("204.00"), VatCalculator.invoiceVat(lines));
+    }
+
+    @Test
+    void negativeRatesAreRejected() {
+        assertThrows(IllegalArgumentException.class,
+                () -> VatCalculator.vatOnNet(new BigDecimal("10.00"), new BigDecimal("-0.20")));
+    }
+}
