 package com.example.deposits;
 
 import java.math.BigDecimal;
+import java.math.RoundingMode;
 import java.time.LocalDate;
+import java.time.Period;
+import java.util.Objects;
 
-/** A money-market deposit booked by Treasury. */
+/** A money-market deposit booked by Treasury. Interest is simple, ACT/360. */
 public record Deposit(BigDecimal principal, BigDecimal annualRate, LocalDate valueDate, LocalDate maturityDate) {
+
+    private static final BigDecimal DAY_COUNT_BASIS = BigDecimal.valueOf(360);
+
+    public Deposit {
+        Objects.requireNonNull(principal, "principal");
+        Objects.requireNonNull(annualRate, "annualRate");
+        Objects.requireNonNull(valueDate, "valueDate");
+        Objects.requireNonNull(maturityDate, "maturityDate");
+        if (principal.signum() <= 0) {
+            throw new IllegalArgumentException("principal must be positive");
+        }
+        if (!maturityDate.isAfter(valueDate)) {
+            throw new IllegalArgumentException("maturity date must be after the value date");
+        }
+    }
+
+    /** Days in the deposit period: value date inclusive, maturity date exclusive. */
+    public int days() {
+        return Period.between(valueDate, maturityDate).getDays();
+    }
+
+    /** Interest payable at maturity, rounded to the cent with banker's rounding. */
+    public BigDecimal interest() {
+        return principal
+                .multiply(annualRate)
+                .multiply(BigDecimal.valueOf(days()))
+                .divide(DAY_COUNT_BASIS, 2, RoundingMode.HALF_EVEN);
+    }
+
+    /** Principal plus interest, as paid out at maturity. */
+    public BigDecimal maturityAmount() {
+        return principal.add(interest());
+    }
 }
diff --git a/tests/com/example/deposits/DepositTest.java b/tests/com/example/deposits/DepositTest.java
new file mode 100644
--- /dev/null
+++ b/tests/com/example/deposits/DepositTest.java
@@ -0,0 +1,38 @@
+package com.example.deposits;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import org.junit.jupiter.api.Test;
+
+class DepositTest {
+
+    private static Deposit deposit(String principal, String rate, LocalDate start, LocalDate end) {
+        return new Deposit(new BigDecimal(principal), new BigDecimal(rate), start, end);
+    }
+
+    @Test
+    void overnightDeposit() {
+        Deposit d = deposit("36000000.00", "0.05", LocalDate.of(2024, 6, 3), LocalDate.of(2024, 6, 4));
+        assertEquals(1, d.days());
+        assertEquals(new BigDecimal("5000.00"), d.interest());
+    }
+
+    @Test
+    void oneWeekDeposit() {
+        Deposit d = deposit("1000000.00", "0.036", LocalDate.of(2024, 6, 3), LocalDate.of(2024, 6, 10));
+        assertEquals(7, d.days());
+        assertEquals(new BigDecimal("700.00"), d.interest());
+        assertEquals(new BigDecimal("1000700.00"), d.maturityAmount());
+    }
+
+    @Test
+    void invalidDepositsAreRejected() {
+        assertThrows(IllegalArgumentException.class,
+                () -> deposit("0", "0.036", LocalDate.of(2024, 6, 3), LocalDate.of(2024, 6, 10)));
+        assertThrows(IllegalArgumentException.class,
+                () -> deposit("100.00", "0.036", LocalDate.of(2024, 6, 3), LocalDate.of(2024, 6, 3)));
+    }
+}
